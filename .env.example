# Environment Variables Template for luxury.Raw Maison

# Database Connection (SQLite for zero-config local testing, or PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://username:password@localhost:5432/luxuryraw?schema=public"

# Authentication & Session Security (Generate a strong random string in production)
JWT_SECRET="your-jwt-secret-key-change-in-production"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Configuration
ADMIN_EMAIL="admin@luxuryraw.com"
